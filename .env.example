# ==============================================================================
# Google Gemini / ADK Configuration
# ==============================================================================
# Option A: Direct Gemini API Key (Recommended for fast local testing)
# Get a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# Option B: Google Cloud Vertex AI (For production or enterprise GCP setup)
# Set to "true" to use Vertex AI instead of Google AI Studio:
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# ==============================================================================
# Model Selection & Reasoning Configuration
# ==============================================================================
COORDINATOR_MODEL=gemini-2.5-pro
EXTRACTION_MODEL=gemini-2.5-flash
TEMPERATURE=0.1

# ==============================================================================
# Application & Environment Settings
# ==============================================================================
ENVIRONMENT=development
DEBUG=true
API_PORT=8080

# ==============================================================================
# SEC EDGAR Ingestion Settings
# ==============================================================================
# OFFLINE_MODE=true  -> filings are served from bundled fixtures. No network
#                       calls. This is the default and is what tests, CI and
#                       the evaluation regression gate rely on.
# OFFLINE_MODE=false -> live HTTP against sec.gov. Before switching:
#                         1. Set a real SEC_EDGAR_USER_AGENT below. SEC
#                            throttles, then IP-bans, callers who do not
#                            identify themselves.
#                         2. Expect non-deterministic eval results - live
#                            filings change and restatements happen.
OFFLINE_MODE=true

# SEC requires the format: "Organization Name contact@domain.com"
SEC_EDGAR_USER_AGENT=InvestmentResearchAgent admin@yourdomain.com
SEC_RATE_LIMIT_PER_SEC=8.0
SEC_HTTP_TIMEOUT_SECONDS=20.0
SEC_HTTP_MAX_RETRIES=3

# ==============================================================================
# Guardrails, Security & Observability
# ==============================================================================
# Audience claim required on every incoming Google-signed ID token. In a
# deployment this is the Cloud Run service URL, because Cloud Run forwards the
# same Authorization header it authenticated the request with.
#
# Comma-separated. Must list every audience a legitimate caller might mint for:
# Cloud Run accepts a token whose `aud` is the service's run.app URL *or* any
# custom audience configured on it, and forwards the header unchanged, so a
# shorter list here rejects requests IAM already allowed.
#
# Left empty here, which means bearer credentials are accepted WITHOUT
# verification and the audit identity is prefixed "unverified-". That is a
# local-development affordance only: Settings refuses to construct with this
# empty when ENVIRONMENT=production.
AUTH_ALLOWED_AUDIENCES=

ENABLE_DLP_MASKING=true
ENFORCE_GUARDRAILS=true
ENABLE_CLOUD_TRACE=false
BIGQUERY_DATASET_ID=ira_financial_intelligence
PUBSUB_TOPIC_ID=ira-research-events
