# ==============================================================================
# IRA local environment overrides (optional).
#
# A .env file is NOT required: every setting has a default in src/config.py and
# configs/settings.yaml, and the defaults run the service fully offline. On Cloud
# Run these values are injected by Terraform (terraform/modules/cloud_run), so the
# file is only for local development. Copy to .env and edit what you need:
#   cp .env.example .env
# ==============================================================================

# --- Runtime mode --------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
OFFLINE_MODE=true                # true = recorded FY2024 SEC corpus (no network); false = live sec.gov
SEC_EDGAR_USER_AGENT=YourOrganisation contact@yourdomain.com   # required when OFFLINE_MODE=false

# --- Google Cloud / Gemini (needed for the ADK agent path: make adk-web, /adk) ---
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GCP_PROJECT_ID=your-gcp-project-id

# --- Model routing & generation (defaults in configs/settings.yaml) --------------
COORDINATOR_MODEL=gemini-2.5-pro
EXTRACTION_MODEL=gemini-2.5-flash
TEMPERATURE=0.1
TOP_P=0.95
MAX_OUTPUT_TOKENS=8192
COORDINATOR_THINKING_BUDGET=2048
SAFETY_HARM_BLOCK_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE

# --- Guardrails & grounding -----------------------------------------------------
DLP_BACKEND=regex                # regex (offline) | cloud_dlp (requires roles/dlp.user)
MAX_PROMPT_CHARS=8000
ENABLE_LIVE_NEWS_GROUNDING=false # true = Google Search grounded macro news specialist (ADK path)

# --- Authentication -------------------------------------------------------------
# Empty = bearer credentials accepted unverified (local only; refused in production).
AUTH_ALLOWED_AUDIENCES=

# --- Observability --------------------------------------------------------------
ENABLE_CLOUD_TRACE=false
ENABLE_ADK_WEB=true              # mounts the ADK developer UI under /adk on the local server
