# ==============================================================================
# Google Gemini / ADK Configuration
# ==============================================================================
# Option A: Direct Gemini API Key (Recommended for fast local testing)
# Get a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# Option B: Google Cloud Vertex AI (For production or enterprise GCP setup)
# Set to "true" to use Vertex AI instead of Google AI Studio:
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# ==============================================================================
# Model Selection & Reasoning Configuration
# ==============================================================================
COORDINATOR_MODEL=gemini-2.5-pro
EXTRACTION_MODEL=gemini-2.5-flash
THINKING_BUDGET=2048
TEMPERATURE=0.1

# ==============================================================================
# Application & Environment Settings
# ==============================================================================
ENVIRONMENT=development
DEBUG=true
API_PORT=8080

# ==============================================================================
# SEC EDGAR Ingestion Settings
# (SEC requires a custom User-Agent in the format: "SampleCompany AdminContact@domain.com")
# ==============================================================================
SEC_EDGAR_USER_AGENT=InvestmentResearchAgent admin@yourdomain.com
SEC_RATE_LIMIT_PER_SEC=8.0

# ==============================================================================
# Guardrails, Security & Observability
# ==============================================================================
ENABLE_DLP_MASKING=true
ENFORCE_GUARDRAILS=true
ENABLE_CLOUD_TRACE=false
BIGQUERY_DATASET_ID=ira_financial_intelligence
PUBSUB_TOPIC_ID=ira-research-events
